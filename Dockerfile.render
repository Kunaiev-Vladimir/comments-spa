
# Этап 1. Сборка Vue.js
FROM node:22-alpine AS frontend-build

WORKDIR /frontend

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build


# Этап 2. Django + Nginx
FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=10000

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    libpq5 nginx supervisor \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/nginx/sites-enabled/default

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY manage.py ./
COPY comments/ ./comments/
COPY comments_spa/ ./comments_spa/

# Готовый Vue
COPY --from=frontend-build /frontend/dist/ /usr/share/nginx/html/

# Конфигурация Nginx для Render
COPY nginx/render.conf /etc/nginx/conf.d/default.conf

RUN mkdir -p /app/staticfiles /app/media

# Supervisor управляет Daphne и Nginx
RUN printf '%s\n' \
    '[supervisord]' \
    'nodaemon=true' \
    'logfile=/dev/null' \
    'logfile_maxbytes=0' \
    '' \
    '[program:daphne]' \
    'command=/usr/local/bin/daphne -b 127.0.0.1 -p 8000 comments_spa.asgi:application' \
    'directory=/app' \
    'autostart=true' \
    'autorestart=true' \
    'stdout_logfile=/dev/fd/1' \
    'stdout_logfile_maxbytes=0' \
    'stderr_logfile=/dev/fd/2' \
    'stderr_logfile_maxbytes=0' \
    '' \
    '[program:nginx]' \
    'command=/usr/sbin/nginx -g "daemon off;"' \
    'autostart=true' \
    'autorestart=true' \
    'stdout_logfile=/dev/fd/1' \
    'stdout_logfile_maxbytes=0' \
    'stderr_logfile=/dev/fd/2' \
    'stderr_logfile_maxbytes=0' \
    > /etc/supervisor/conf.d/render.conf

RUN nginx -t

EXPOSE 10000

CMD ["sh", "-c", "python manage.py migrate --noinput && python manage.py collectstatic --noinput && exec supervisord -c /etc/supervisor/supervisord.conf"]
